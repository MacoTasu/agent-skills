#!/bin/bash
# loop-init — 任意のリポジトリで loop-engine を回すための初期セットアップ。
# spec-kit の設定確認・hooks scaffold・settings.json の hooks 配線までを一括で行う。
# 何度実行しても安全（既存物はスキップ・settings は壊さずマージ・spec-kit の設定は確認して案内するだけ）。
set -e

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "error: git リポジトリではありません" >&2
  exit 1
}

REPO_NAME=$(basename "$REPO_ROOT")
# ハーネス参照物は本スクリプトと同じプラグイン内にある。
# 自身の位置から解決するので PATH 登録も symlink も不要
# （プラグイン配布・リポジトリ直実行のどちらでも動く）。
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
HARNESS_DIR="${CLAUDE_PLUGIN_ROOT:-$(dirname "$SCRIPT_DIR")}/skills/loop-engine/reference"

# 言語マーカーを検出（root ＋ 代表的な subdir）→ 推奨 validation を提案する
detect_langs() {
  local found="" base d rel
  for base in . backend frontend api server app web; do
    d="$REPO_ROOT/$base"
    [ -d "$d" ] || continue
    rel="$base"; [ "$base" = "." ] && rel="(root)"
    if [ -f "$d/go.mod" ]; then
      found="${found}  Go      [$rel] validate: gofmt -l / go vet ./...    gate: go build ./... && go test ./...\n"
    fi
    if [ -f "$d/package.json" ]; then
      found="${found}  Node/TS [$rel] validate: tsc --noEmit / eslint     gate: npm test\n"
    fi
    if [ -f "$d/pyproject.toml" ] || [ -f "$d/setup.py" ]; then
      found="${found}  Python  [$rel] validate: ruff / black --check      gate: pytest\n"
    fi
  done
  printf '%b' "$found"
}

# spec-kit の設定を確認する（仕様は spec-kit の specs/<機能>/。書き換えはせず、足りなければ案内する）
SPECKIT_TODO=""
if [ ! -d "$REPO_ROOT/.specify" ]; then
  echo "todo:    spec-kit が未初期化です（.specify/ がありません）"
  SPECKIT_TODO="${SPECKIT_TODO}  - spec-kit を初期化してコミット: specify init --here --force --non-interactive --integration claude --script sh\n"
else
  echo "ok:      spec-kit 初期化済み（.specify/）"
  OPTS="$REPO_ROOT/.specify/init-options.json"
  NUMBERING=""
  if [ -f "$OPTS" ]; then
    NUMBERING=$(grep -oE '"(feature|branch)_numbering"[[:space:]]*:[[:space:]]*"[a-z]+"' "$OPTS" | head -1 | grep -oE '"[a-z]+"$' | tr -d '"')
  fi
  if [ "$NUMBERING" = "timestamp" ]; then
    echo "ok:      仕様の番号はタイムスタンプ方式"
  else
    echo "todo:    仕様の番号が連番（${NUMBERING:-未設定}）です"
    SPECKIT_TODO="${SPECKIT_TODO}  - .specify/init-options.json の feature_numbering を \"timestamp\" に（並行する仕様の PR の番号衝突を防ぐ）\n"
  fi
  CONSTITUTION="$REPO_ROOT/.specify/memory/constitution.md"
  if [ -f "$CONSTITUTION" ] && grep -qE 'FR-[0-9#]|自動テスト|automated test' "$CONSTITUTION"; then
    echo "ok:      constitution にテストの原則らしき記述あり（内容は人間が確認）"
  else
    echo "todo:    constitution に自動テストの原則が見当たりません"
    SPECKIT_TODO="${SPECKIT_TODO}  - constitution に追加:「spec.md の各 FR と各受け入れシナリオは自動テストを持たなければならない（MUST）。テストに基準 ID（FR-001 など）を書く」\n"
  fi
fi

# hooks（プロジェクト固有 validation）の雛形を scaffold（既定 no-op・project が中身を書く）
HOOKS_DIR="$REPO_ROOT/.claude/hooks"
mkdir -p "$HOOKS_DIR"
for h in validate gate guard; do
  SRC="$HARNESS_DIR/hooks/$h.sh.example"
  DEST="$HOOKS_DIR/$h.sh"
  if [ -f "$DEST" ]; then
    echo "skip:    .claude/hooks/$h.sh は既に存在します"
  elif [ -f "$SRC" ]; then
    if ! { cp "$SRC" "$DEST" && chmod +x "$DEST"; }; then
      echo "error:   .claude/hooks/$h.sh を作成できませんでした（${DEST}）" >&2
      exit 1
    fi
    if [ "$h" = guard ]; then
      echo "created: .claude/hooks/guard.sh（git commit / push 前の公開物ガード。REQUIRE_NOREPLY と NG_WORDS を設定）"
    else
      echo "created: .claude/hooks/$h.sh（既定 no-op。project 固有チェックを書く）"
    fi
  else
    echo "warn:    $h.sh.example が見つかりません（${SRC}）。スキップ"
  fi
done

# .claude/settings.json に hooks を配線（無ければ作成・hooks が無ければ追記。既存 hooks は書き換えず、guard の配線が無ければ todo を出す）
SETTINGS="$REPO_ROOT/.claude/settings.json"
# settings.json は一時ファイルに書いてから mv する（jq が失敗したときに空にしないため）
settings_write_failed() {
  rm -f "$SETTINGS.tmp"
  echo "error:   .claude/settings.json を書けませんでした（元のファイルは変えていません）" >&2
  exit 1
}
SNIPPET="$HARNESS_DIR/hooks/settings.hooks.json"
# guard.sh.example が無い（＝guard.sh を scaffold できない）ときは PreToolUse を配線しない。
# 配線だけあると、guard.sh が無いことを理由に全 Bash が止まるため
GUARD_TODO=""
HOOKS_FILTER='.hooks'
if [ ! -f "$HARNESS_DIR/hooks/guard.sh.example" ] && [ ! -f "$HOOKS_DIR/guard.sh" ]; then
  HOOKS_FILTER='(.hooks | del(.PreToolUse))'
  echo "warn:    guard.sh.example が無いため PreToolUse（guard）の配線をしません"
fi
if ! command -v jq >/dev/null 2>&1; then
  echo "warn:    jq が無いため settings 自動配線をスキップ。手で $SNIPPET の hooks を貼ってください"
elif [ ! -f "$SNIPPET" ]; then
  echo "warn:    settings.hooks.json が見つかりません（${SNIPPET}）。settings 配線をスキップ"
elif [ -f "$SETTINGS" ] && ! jq -e . "$SETTINGS" >/dev/null 2>&1; then
  echo "error:   .claude/settings.json が JSON として読めません。直してから再実行してください（書き換えていません）" >&2
  exit 1
elif [ ! -f "$SETTINGS" ]; then
  jq "{hooks: $HOOKS_FILTER}" "$SNIPPET" > "$SETTINGS.tmp" || settings_write_failed
  mv "$SETTINGS.tmp" "$SETTINGS"
  echo "created: .claude/settings.json（hooks 配線済み）"
elif jq -e '.hooks' "$SETTINGS" >/dev/null 2>&1; then
  # 既存の hooks は書き換えない。guard の配線が無いときだけ案内する
  if jq -e '[.hooks.PreToolUse[]? | select((.matcher // "") | test("(^|\\|)Bash(\\||$)")) | .hooks[]? | select((.command // "") | test("hooks/guard\\.sh"))] | length > 0' "$SETTINGS" >/dev/null 2>&1; then
    echo "skip:    .claude/settings.json に hooks は既にあります（手で確認）"
  else
    echo "todo:    .claude/settings.json の hooks.PreToolUse に guard.sh の配線がありません（$SNIPPET の PreToolUse を手で足す）"
    GUARD_TODO="  - .claude/settings.json の hooks.PreToolUse に guard.sh を配線する（$SNIPPET の PreToolUse を手で足す）\n"
  fi
else
  cp "$SETTINGS" "$SETTINGS.bak"
  jq --slurpfile s "$SNIPPET" ". + {hooks: (\$s[0] | $HOOKS_FILTER)}" "$SETTINGS.bak" > "$SETTINGS.tmp" || settings_write_failed
  mv "$SETTINGS.tmp" "$SETTINGS"
  echo "merged:  .claude/settings.json に hooks を追記（backup: settings.json.bak）"
fi

# .claude/settings.json にプラグイン宣言を追記（ローカルセッション向け）
# 注意: これは cloud routine には効かない。repo の settings.json に宣言しても cloud 側に
# プラグインはインストールされない（実測。reference/routine.md の「cloud にプラグインは
# 届かない」節を参照）。cloud のハーネス配送は発火プロンプト内の clone で行う。
# ここで宣言する意味は、別マシンや他の人がこのリポジトリを手元で触るときに 3 プラグインが
# 有効になること。
if command -v jq >/dev/null 2>&1 && [ -f "$SETTINGS" ]; then
  if jq -e '.enabledPlugins["loop-engine@macotasu-agent-skills"]' "$SETTINGS" >/dev/null 2>&1; then
    echo "skip:    .claude/settings.json にプラグイン宣言は既にあります"
  else
    cp "$SETTINGS" "$SETTINGS.plugins.bak"
    jq '
      .extraKnownMarketplaces["macotasu-agent-skills"] //= {source: {source: "github", repo: "MacoTasu/agent-skills"}}
      | .enabledPlugins["review-judge@macotasu-agent-skills"]   //= true
      | .enabledPlugins["dev-crew@macotasu-agent-skills"]       //= true
      | .enabledPlugins["loop-engine@macotasu-agent-skills"]    //= true
    ' "$SETTINGS.plugins.bak" > "$SETTINGS.tmp" || settings_write_failed
    mv "$SETTINGS.tmp" "$SETTINGS"
    echo "merged:  .claude/settings.json にプラグイン宣言を追記（ローカル用。cloud には効かない）"
  fi
fi

# ---- 完了サマリ（残り作業を言語検出付きで案内）----
echo ""
echo "=== loop-init 完了 ==="
LANGS=$(detect_langs)
echo ""
if [ -n "$LANGS" ]; then
  echo "検出した言語と推奨 validation（.claude/hooks/{validate,gate}.sh に記入）:"
  printf '%b' "$LANGS"
  echo "  ※ monorepo は (cd <dir> && <cmd>) で対象ディレクトリを指定する"
else
  echo "言語マーカー未検出。.claude/hooks/{validate,gate}.sh を手で記入してください（guard.sh は設定変数だけ）。"
fi
echo ""
if [ -n "$SPECKIT_TODO" ]; then
  echo "spec-kit の設定で足りないもの（このスクリプトは書き換えない）:"
  printf '%b' "$SPECKIT_TODO"
  echo ""
fi
echo "残り:"
echo "  1. .claude/hooks/{validate,gate}.sh に上記コマンドを記入（既定 no-op のまま回しても可）。"
echo "     .claude/hooks/guard.sh は既定で秘匿情報の grep のみ。public リポジトリなら REQUIRE_NOREPLY=1、止めたい語は NG_WORDS に"
echo "     .claude/hooks/guard.sh は .claude/settings.json と一緒にコミットする（配線だけあって guard.sh が無いと全 Bash が止まる）"
if [ -n "$GUARD_TODO" ]; then printf '%b' "$GUARD_TODO"; fi
echo "  2. spec-kit で仕様を書いて仕様の PR をマージ（/conductor:dev の親、/spec-intake:spec-draft <issue番号>、または /speckit-specify から手で）"
echo "  3. /loop-engine:loop-engine <機能> → 実装→司法→PR まで進んで PR で停止（マージは人間）"
