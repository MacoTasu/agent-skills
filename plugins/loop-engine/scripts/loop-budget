#!/bin/bash
# loop-budget — 当日の Claude Code 総コストを ccusage で取得し、日次キャップと照合する。
#
# autonomy-gates の G1（autonomous-entry 冒頭）が呼ぶコストゲート。
# ccusage が全プロジェクト合算の日次総額を返すので、本ゲートは「その日の総 CC 支出」を見る。
# ループは後回し可能な低優先の消費者なので、総額が高い日は自律ループを絞るのが妥当（理由）。
#
# 価格表は ccusage が維持する（自前の埋め込み表だと陳腐化するため DRY で委譲）。
# ccusage 不在なら警告して exit 0 ＝ ループは止めない（ハーネスは全プロジェクト配布のため移植性優先）。
#
# 終了コード:
#   0  … 予算 80% 未満（通常進行）
#   10 … 80〜100%（新規 L2 を見送り。L1 報告は安いので許容）
#   20 … 100% 超過（full no-op）
#
# 上書き: LOOP_DAILY_BUDGET_USD で日次キャップ（既定 $20）を変更できる。
set -uo pipefail

CAP="${LOOP_DAILY_BUDGET_USD:-20}"
WARN_PCT=80

CCUSAGE=$(command -v ccusage || true)
if [ -z "$CCUSAGE" ]; then
  echo "loop-budget: ccusage 未インストール → 予算チェックをスキップ（brew install ccusage で有効化）" >&2
  exit 0
fi

TODAY=$(date +%Y-%m-%d)
RAW=$("$CCUSAGE" daily --json --since "$TODAY" --until "$TODAY" --offline 2>/dev/null) || RAW=""
COST=$(printf '%s' "$RAW" | jq -r '[.daily[].totalCost] | add // 0' 2>/dev/null) || COST=0
[ -z "$COST" ] && COST=0

PCT=$(awk -v c="$COST" -v cap="$CAP" 'BEGIN{ if(cap+0<=0){print 0; exit} printf "%d",(c/cap)*100 }')
printf 'loop-budget: $%.2f / $%.2f (%d%%) [today=%s, 全プロジェクト合算]\n' "$COST" "$CAP" "$PCT" "$TODAY"

if   [ "$PCT" -ge 100 ];        then exit 20
elif [ "$PCT" -ge "$WARN_PCT" ]; then exit 10
fi
exit 0
